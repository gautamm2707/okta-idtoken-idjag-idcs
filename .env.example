# Run python -m app.cli init to create .env and an RSA keypair.
APP_SECRET=
BASE_URL=http://localhost:4141
OKTA_ORG_URL=https://integrator-1242259.okta.com
OKTA_SAML_SSO_URL=
OKTA_SAML_IDP_ISSUER=
OKTA_SAML_CERT_FILE=secrets/okta-saml.crt
OKTA_AGENT_CLIENT_ID=
OKTA_AGENT_KEY_FILE=secrets/okta-agent.pem
OKTA_AGENT_KID=okta-agent-1
BOOTSTRAP_SCOPE=openid offline_access email
# Exact issuer from this tenant's public discovery (trailing slash matters).
IDCS_ISSUER=https://idcs-ff3532e3a9ba4bd7887f5cf49e2ae425.identity.oraclecloud.com/
IDCS_TOKEN_ENDPOINT=https://idcs-ff3532e3a9ba4bd7887f5cf49e2ae425.identity.oraclecloud.com:443/oauth2/v1/token
IDCS_JWKS_URL=https://idcs-ff3532e3a9ba4bd7887f5cf49e2ae425.identity.oraclecloud.com:443/admin/v1/SigningCert/jwk
IDCS_CLIENT_ID=
IDCS_CLIENT_SECRET=
# The primary audience and fully qualified scope of the IDCS resource app.
RESOURCE_AUDIENCE=http://localhost:4142
# IDCS API scope profile used by the working XAA connection.
REQUESTED_SCOPE=urn:opc:idm:__myscopes__
# To call the local demo API, authorize and request its custom scope instead:
# REQUESTED_SCOPE=http://localhost:4142/demo:read
RESOURCE_REQUIRED_SCOPE=http://localhost:4142/demo:read
# Blank derives IDCS_ISSUER + /admin/v1/Users; optional override for another API.
RESOURCE_URL=
# Inbound trust maps this signed Okta claim to a unique active IDCS userName.
IDCS_SUBJECT_CLAIM=email
OKTA_OIDC_CLIENT_ID=''
OKTA_OIDC_CLIENT_SECRET=''
OKTA_OIDC_AUTH_METHOD='client_secret_basic'
OKTA_OIDC_REDIRECT_URI='http://localhost:4141/oidc/callback'
OKTA_OIDC_SCOPE='openid profile email offline_access'
OKTA_XAA_SUBJECT_TOKEN_TYPE='id_token'
# These must match the identifiers configured in Okta; trailing slashes matter.
OKTA_XAA_AUDIENCE=https://idcs-ff3532e3a9ba4bd7887f5cf49e2ae425.identity.oraclecloud.com
OKTA_XAA_RESOURCE=https://idcs-ff3532e3a9ba4bd7887f5cf49e2ae425.identity.oraclecloud.com

# Optional inbound trust settings; blank values use the defaults shown here.
# Source defaults to OKTA_OIDC_CLIENT_ID (legacy SAML-only: IDCS_CLIENT_ID).
IDCS_TRUST_SOURCE_CLIENT_ID=
IDCS_TRUST_NAME=Inbound ID-JAG trust
IDCS_SUBJECT_MAPPING_ATTRIBUTE=userName
IDCS_ADMIN_SCOPE=urn:opc:idm:__myscopes__
